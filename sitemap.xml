---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in site.navigation %}
  <url><loc>{{ item.url | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
{%- for file in site.static_files %}{% if file.extname == ".pdf" %}
  <url><loc>{{ file.path | uri_escape | absolute_url }}</loc></url>
{%- endif %}{% endfor %}
</urlset>
